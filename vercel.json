{
  "redirects": [
    {
      "source": "/",
      "has": [
        {
          "type": "host",
          "value": "frontlinegroupofschool.vercel.app"
        }
      ],
      "destination": "https://frontlinegroupofsch.com.ng/",
      "permanent": true
    },
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "frontlinegroupofschool.vercel.app"
        }
      ],
      "destination": "https://frontlinegroupofsch.com.ng/:path*",
      "permanent": true
    }
  ]
}
